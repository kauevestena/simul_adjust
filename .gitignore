.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.pytype/
.ruff_cache/
.hypothesis/

# Jupyter
.ipynb_checkpoints/

# Environment and local config
.env
.env.*
!.env.example
*.local

# Logs and temporary files
*.log
*.tmp
*.temp

# OS metadata
.DS_Store
Thumbs.db
